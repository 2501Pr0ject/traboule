{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "description": "Preuve : se lit par document, page, zone et chemin, pas par identifiant de passage.",
      "properties": {
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "doc_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doc Id"
        },
        "page": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "passage_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Passage Id"
        },
        "zone_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Zone Code"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "source_id"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Question du jeu de référence (benchmarks/datasets/gold).",
  "properties": {
    "id": {
      "pattern": "^(FAC|DOC|MIX|ABS)-[0-9]{3}$",
      "title": "Id",
      "type": "string"
    },
    "dataset_version": {
      "title": "Dataset Version",
      "type": "string"
    },
    "category": {
      "enum": [
        "factual",
        "documentary",
        "mixed",
        "unanswerable"
      ],
      "title": "Category",
      "type": "string"
    },
    "subtype": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Pour unanswerable : near_miss_level, nonexistent_entity, out_of_version, masked_by_diffusion, out_of_corpus, future_value. Pour les autres : libre (count, filter, spatial, rule_lookup...).",
      "title": "Subtype"
    },
    "expected_route": {
      "enum": [
        "SQL",
        "RAG",
        "HYBRID",
        "ABSTAIN"
      ],
      "title": "Expected Route",
      "type": "string"
    },
    "question": {
      "minLength": 10,
      "title": "Question",
      "type": "string"
    },
    "as_of": {
      "description": "Date d'ancrage de la question",
      "format": "date",
      "title": "As Of",
      "type": "string"
    },
    "source_versions": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "source_id -> version ou date du fichier utilisé (ex. SRC-001a: 2026-10-01, SRC-005: identifiant de version GPU)",
      "title": "Source Versions",
      "type": "object"
    },
    "expected_answer": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Answer"
    },
    "acceptance_criteria": {
      "description": "Critères vérifiables : valeur exacte, tolérance, éléments obligatoires, abstention attendue",
      "items": {
        "type": "string"
      },
      "title": "Acceptance Criteria",
      "type": "array"
    },
    "expected_sql": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Requête de référence relue par l'humain",
      "title": "Expected Sql"
    },
    "expected_result": {
      "default": null,
      "description": "Résultat d'exécution de la requête de référence (comparaison par résultat, pas par texte) ; c'est la référence, la requête n'en est que la trace",
      "title": "Expected Result"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Evidence",
      "type": "array"
    },
    "abstention_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Pour unanswerable : pourquoi aucune réponse fiable n'est possible, et quelle information proche existe",
      "title": "Abstention Reason"
    },
    "difficulty": {
      "anyOf": [
        {
          "enum": [
            "easy",
            "medium",
            "hard"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Difficulty"
    },
    "status": {
      "enum": [
        "draft",
        "validated",
        "rejected"
      ],
      "title": "Status",
      "type": "string"
    },
    "validated_by": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Validated By"
    },
    "validated_at": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Validated At"
    },
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notes"
    }
  },
  "required": [
    "id",
    "dataset_version",
    "category",
    "expected_route",
    "question",
    "as_of",
    "source_versions",
    "status"
  ],
  "title": "Traboule gold question",
  "type": "object"
}
